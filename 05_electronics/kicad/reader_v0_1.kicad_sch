(text "Measurement sequence (firmware 07_firmware/reader_v0_1):" (exclude_from_sim no) (at 20.32 144.78 0) (effects (font (size 1.27 1.27) ) (justify left)) (uuid "e42b2bd7-99b5-56dc-9fe6-5dd48e91fe1a"))
(text "1 Zone C: DRV_C and DRV_REF drive, all other drive pins high-Z. Phase +: DRV_C=1, DRV_REF=0; phase -: DRV_C=0, DRV_REF=1." (exclude_from_sim no) (at 20.32 148.08 0) (effects (font (size 1.27 1.27) ) (justify left)) (uuid "fbef337a-4c4f-5ca1-8216-d71cfe63b4ce"))
(text "   Rx = Rref(Vdd/VN - 1) (phase +), Rx = Rref VN/(Vdd - VN) (phase -); average; subtract R1 + R3 = 2 x 1k." (exclude_from_sim no) (at 20.32 151.38 0) (effects (font (size 1.27 1.27) ) (justify left)) (uuid "0f830660-d4ba-5ef2-aed3-e91a4a3cb61b"))
(text "2 Zone A: same with DRV_A.   3 Loop: DRV_LOOP vs DRV_REF through COM2 -> COM loop -> COM1 (open = FAULT)." (exclude_from_sim no) (at 20.32 154.68 0) (effects (font (size 1.27 1.27) ) (justify left)) (uuid "0e9eed56-efd4-5d22-8336-790581255326"))
(text "4 Check: DRV_CHK vs DRV_REF (known 100k) -> gain/loading correction. Between scans every drive pin is high-Z (no DC on the strip)." (exclude_from_sim no) (at 20.32 157.98 0) (effects (font (size 1.27 1.27) ) (justify left)) (uuid "d19d0940-aaec-5295-9992-d972b29face7"))
(text "Thresholds (calc_readout): wet < 100 kohm, dry > 300 kohm, 3 consecutive scans. States: OK / CHANGE / CHECK (A wet before C) / FAULT." (exclude_from_sim no) (at 20.32 161.28 0) (effects (font (size 1.27 1.27) ) (justify left)) (uuid "86add04d-6cf9-5374-bcb5-de8c79980c75"))
