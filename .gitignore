fp-info-cache
_autosave-*
*.lck

# Arduino / PlatformIO build output
build/
.pio/

# Office lock files
.~lock.*

# Private team records (application confirmation, Stage 1 proposal): never committed
_private/

# Test caches and scratch output
.pytest_cache/
output/
tmp/
